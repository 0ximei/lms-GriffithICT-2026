{
  "manifest_version": 3,
  "name": "Reel Fullscreen Viewer",
  "version": "1.0.0",
  "default_icon": "icon.png",
  "description": "Watch Videos in Canvas LMS videos in a fullscreen canvas overlay",
  "permissions": ["storage", "tabs", "activeTab", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.griffith.edu.au/*",
    "*://*.qut.edu.au/*",
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.griffith.edu.au/*",
        "*://*.qut.edu.au/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reel Fullscreen Viewer"
  }
}